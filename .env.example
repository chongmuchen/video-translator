# Runtime
VT_DATA_DIR=./data
VT_MAX_VIDEO_SECONDS=7200
VT_MAX_DOWNLOAD_HEIGHT=1080
VT_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,bilibili.com,www.bilibili.com,b23.tv,podcasts.apple.com
# Only use cookies for content you are authorized to access.
# VT_COOKIES_FROM_BROWSER=chrome
# VT_COOKIE_FILE=/absolute/path/to/cookies.txt

# Downloader reliability. "auto" uses system curl for Bilibili media files
# and yt-dlp's native downloader elsewhere.
VT_DOWNLOAD_BACKEND=auto
VT_DOWNLOAD_RETRIES=10
VT_DOWNLOAD_FRAGMENT_RETRIES=10
VT_DOWNLOAD_SOCKET_TIMEOUT=30
VT_DOWNLOAD_HTTP_CHUNK_SIZE=10485760
# Override the macOS system proxy. Use "direct" in main.py to bypass it.
# VT_DOWNLOAD_PROXY=http://127.0.0.1:7897
# Optional browser TLS impersonation, e.g. chrome.
# VT_DOWNLOAD_IMPERSONATE=chrome

# Set these only when ffmpeg/ffprobe are not on PATH.
# VT_FFMPEG_BIN=/absolute/path/to/ffmpeg
# VT_FFPROBE_BIN=/absolute/path/to/ffprobe

# ASR: auto chooses CUDA when available, otherwise CPU.
VT_ASR_MODEL=large-v3
VT_ASR_DEVICE=auto
VT_ASR_COMPUTE_TYPE=auto
VT_SOURCE_LANGUAGE=

# Translation through any OpenAI-compatible endpoint.
# Ollama example:
VT_TRANSLATOR_PROVIDER=openai_compatible
VT_TRANSLATOR_BASE_URL=http://127.0.0.1:11434/v1
VT_TRANSLATOR_MODEL=qwen3:8b
VT_TRANSLATOR_API_KEY=
VT_TRANSLATOR_TIMEOUT_SECONDS=180

# Use "passthrough" only for pipeline testing; it does not translate.
# VT_TRANSLATOR_PROVIDER=passthrough

# TTS. edge is convenient for an MVP but is an online service.
VT_TTS_PROVIDER=edge
VT_TTS_VOICE=zh-CN-XiaoxiaoNeural
VT_TTS_RATE=+0%
VT_TTS_VOLUME=+0%

# Generic HTTP TTS option. The endpoint receives JSON:
# {"text":"...", "voice":"...", "rate":"+0%"}
# and must return audio bytes.
# VT_TTS_PROVIDER=http
# VT_TTS_HTTP_URL=http://127.0.0.1:9880/tts
# VT_TTS_HTTP_API_KEY=

# Official CosyVoice FastAPI runtime (returns raw PCM).
# VT_TTS_PROVIDER=cosyvoice
# VT_COSYVOICE_BASE_URL=http://127.0.0.1:50000
# VT_COSYVOICE_MODE=sft
# VT_TTS_VOICE=中文女
# For zero_shot/cross_lingual/instruct2:
# VT_COSYVOICE_PROMPT_WAV=/absolute/path/to/authorized-prompt.wav
# VT_COSYVOICE_PROMPT_TEXT=参考音频对应的准确文本
# VT_COSYVOICE_INSTRUCT_TEXT=请使用平静、自然的中文旁白风格

# Output
VT_KEEP_ORIGINAL_AUDIO=true
VT_DUCK_ORIGINAL_AUDIO=true
VT_BURN_SUBTITLES=false
VT_ENABLE_DEMUCS=false

# API server
VT_API_HOST=127.0.0.1
VT_API_PORT=8000
VT_WORKER_COUNT=1
